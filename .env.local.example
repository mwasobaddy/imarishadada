# Copy to .env.local and fill in. NEVER commit .env.local.
#
# Get the values from the Supabase dashboard for project qbipjvbbpgggempnzfrp:
#   Project Settings → API
#
# The key below is the PUBLISHABLE (anon) key. It is designed to be public —
# it ships in the browser bundle. Row-Level Security is the only thing standing
# between the internet and this data. Never put the service-role key here, and
# never prefix it with NEXT_PUBLIC_.

NEXT_PUBLIC_SUPABASE_URL=https://qbipjvbbpgggempnzfrp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Donation payments
# ---------------------------------------------------------------------------
# Which payment adapter `/donate` uses. See lib/donate/adapter.ts.
#
#   mock        — simulate the provider. NEVER set this on the real site: a
#                 donor would see "thank you" for money nobody collected.
#   production  — real adapters only; the mock is refused at the first donation.
#
# Leave it unset in development and it defaults to `mock`. Leave it unset in a
# production build and it defaults to `production`, which is the safe default:
# a misconfigured deploy fails loudly rather than issuing a fake receipt.
NEXT_PUBLIC_DONATE_MODE=

# M-Pesa Daraja callback verification. Required for /api/mpesa/callback to
# accept anything — without it every callback is rejected, because an
# unverifiable callback must never be trusted.
MPESA_CALLBACK_SECRET=

# Server-only. Bypasses RLS, so it is the only way to write the donation
# ledger. NEVER prefix with NEXT_PUBLIC_, and never import it client-side.
SUPABASE_SERVICE_ROLE_KEY=

# Resend transactional email (staff invitations, enquiry notifications).
RESEND_API_KEY=
